{
    "name": "atlas-auth/atlas-php",
    "description": "Official PHP backend SDK for Atlas — the secret-key Backend API client plus session-token/JWT verification.",
    "type": "library",
    "keywords": ["atlas", "auth", "authentication", "authorization", "sdk", "jwt", "sso"],
    "license": "MIT",
    "homepage": "https://atlas.dev",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "guzzlehttp/guzzle": "^7.5",
        "firebase/php-jwt": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Atlas\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atlas\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
