{
    "name": "atlas-auth/atlas-drupal",
    "description": "Log in with Atlas: a Drupal module for OpenID Connect single sign-on, built on the official Atlas PHP SDK.",
    "type": "drupal-module",
    "keywords": ["atlas", "auth", "drupal", "oidc", "oauth", "sso", "login"],
    "license": "MIT",
    "homepage": "https://atlasauth.net",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "atlas-auth/atlas-php": "*",
        "drupal/core": "^10.3 || ^11",
        "drupal/externalauth": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "versions": {
                    "atlas-auth/atlas-php": "0.1.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Drupal\\atlas_auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Drupal\\atlas_auth\\Tests\\": "tests/src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
